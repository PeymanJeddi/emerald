# Database
DATABASE_URL=postgresql://esc:esc_secret@postgres:5432/emerald_scholars

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=86400

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Frontend API URL (used by Next.js apps)
NEXT_PUBLIC_API_URL=http://localhost:8000

# App URLs (public site links to user portal for sign-in / apply)
NEXT_PUBLIC_USER_PORTAL_URL=http://localhost:3001
NEXT_PUBLIC_PUBLIC_WEB_URL=http://localhost:3000

# File uploads
UPLOAD_DIR=/app/uploads

# Seed demo data on backend startup (set to false in production)
RUN_SEED=true

# Postgres (docker-compose)
POSTGRES_USER=esc
POSTGRES_PASSWORD=esc_secret
POSTGRES_DB=emerald_scholars
